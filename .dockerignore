# Only runtime source and required build inputs belong in the build context.
**
!Dockerfile
!.dockerignore
!requirements-runtime.txt
!scripts/
!scripts/install-browser.py
!scripts/prune-runtime.py
!app/
!app/**
app/**/__pycache__/
app/**/*.pyc
app/**/*.pyo

# The allowlist above also excludes .git, .env*, venv/.venv, tests, logs,
# node_modules, dist exports, editor settings, and all local caches.
