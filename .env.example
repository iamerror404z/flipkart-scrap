# ---- Application ----
SERVICE_NAME=flipkart-scraper
DEBUG=false

# ---- HTTP Scraping ----
HTTPX_TIMEOUT=30.0
HTTPX_CONNECT_TIMEOUT=10.0
HTTPX_RETRIES=2
HTTPX_RETRY_BACKOFF=1.0
HTTPX_FORCE_IPV4=true
# Optional: Indian residential/ISP HTTP proxy; used by HTTP AND Chromium.
# FLIPKART_PROXY=http://user:password@proxy-host:port
# HTTPS_PROXY is accepted when FLIPKART_PROXY is unset.
HTTPX_MAX_REDIRECTS=5
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

# ---- Playwright ----
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_MAX_CONCURRENT=1
PLAYWRIGHT_SLOW_MO=0

# ---- Batch Processing ----
BATCH_MAX_PRODUCTS=20
BATCH_CONCURRENCY=1

# ---- Rate Limiting ----
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60
